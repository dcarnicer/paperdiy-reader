{
  "crosspoint": {
    "repo_url": "https://github.com/crosspoint-reader/crosspoint-reader.git",
    "upstream_ref": "upstream/develop",
    "mirror_ref": "main",
    "version_file": "platformio.ini",
    "build_files": [
      "platformio.ini",
      "sdkconfig.default",
      "sdkconfig.defaults",
      "partitions.csv",
      "partitions_picco.csv",
      ".gitmodules"
    ]
  },
