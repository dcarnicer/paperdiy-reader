+  bool hasGaugeBackend() const;
+  bool hasM5Pm1Backend() const;
+  bool readM5Pm1Status(Status& status) const;
+
+  int8_t _adcPin;
+  float _dividerMultiplier;
+  int8_t _chargeStatusPin;
 };
