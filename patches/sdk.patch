diff --git a/freeink-sdk/libs/hardware/BoardPaperDiy/include/BoardPaperDiy.h b/freeink-sdk/libs/hardware/BoardPaperDiy/include/BoardPaperDiy.h
new file mode 100644
index 00000000..6d6c8609
--- /dev/null
+++ b/freeink-sdk/libs/hardware/BoardPaperDiy/include/BoardPaperDiy.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <Arduino.h>
+
+#include "BoardPaperDiyPins.h"
+
+// The PaperDIY power button is owned by the M5PM1. When this is enabled the
+// PM1 single-click reset is disabled and clicks are surfaced to CrossPoint as
+// BTN_POWER (the default short action can sleep/shut down). Set to 0 to keep
+// the factory single-click reset behaviour (A+B still synthesizes BTN_POWER).
+#ifndef PAPERDIY_PM1_APP_POWER_BUTTON
+#define PAPERDIY_PM1_APP_POWER_BUTTON 1
+#endif
+
+namespace BoardPaperDiy {
+
+// One-time PM1 bring-up: charger + 5 V DCDC, EPD rail GPIO2, CHG_STAT GPIO3 and
+// (optionally) the PM1 power-button event mode. Idempotent, retries on failure.
+bool ensureBooted();
+
+// Raise/cut the PM1 EPD rail (GPIO2). setEpdPower(true) waits for the rail to
+// settle; the panel's own GPIO46 boost is sequenced by Bus_EPD.
+bool setEpdPower(bool enabled);
+
+// Called by the LgfxEpdConfig prepare() hook before Bus_EPD powers the panel.
+bool prepareEpdPower();
+
+// Cut the PM1 EPD rail after the panel has been put to sleep.
+void powerDownEpdPower();
+
+// Read-clear the PM1 power-button event. Rate-limited to one I2C poll every
+// 250 ms; returns true once per click.
+bool pollPowerButtonClicked(unsigned long nowMs);
+
+// Full system power-off through the M5PM1 (SYS_CMD 0xA1).
+void powerOff();
+
+}  // namespace BoardPaperDiy
diff --git a/freeink-sdk/libs/hardware/BoardPaperDiy/include/BoardPaperDiyPins.h b/freeink-sdk/libs/hardware/BoardPaperDiy/include/BoardPaperDiyPins.h
new file mode 100644
index 00000000..f0b9a5eb
--- /dev/null
+++ b/freeink-sdk/libs/hardware/BoardPaperDiy/include/BoardPaperDiyPins.h
@@ -0,0 +1,34 @@
+#pragma once
+
+// M5Stack PaperDIY pin map. The parallel-EPD bus is *identical* to the
+// M5Stack PaperS3 (M5GFX board_M5PaperDIY / board_M5PaperS3 share the same
+// Bus_EPD wiring); the differences are the two user buttons, the M5PM1 PMIC
+// rails, and the absence of touch/RTC/IMU.
+
+// ED047TC1 8-bit parallel data bus, D0..D7.
+#define PAPERDIY_EP_D0 6
+#define PAPERDIY_EP_D1 14
+#define PAPERDIY_EP_D2 7
+#define PAPERDIY_EP_D3 12
+#define PAPERDIY_EP_D4 9
+#define PAPERDIY_EP_D5 11
+#define PAPERDIY_EP_D6 8
+#define PAPERDIY_EP_D7 10
+
+// Row/frame timing. Bus_EPD's stock power sequence drives OE/PWR/SPV itself;
+// the PM1 GPIO2 EPD rail is raised by BoardPaperDiy::prepareEpdPower().
+#define PAPERDIY_EP_SPH 13  // XSTL: start pulse, horizontal
+#define PAPERDIY_EP_CL 16   // XCL: pixel clock
+#define PAPERDIY_EP_LE 15   // XLE: latch enable
+#define PAPERDIY_EP_SPV 17  // start pulse, vertical
+#define PAPERDIY_EP_CKV 18  // vertical clock
+#define PAPERDIY_EP_OE 45   // output enable
+#define PAPERDIY_EP_PWR 46  // EPD rail enable (boost converter)
+
+// Two user buttons, active-low (M5Unified BtnA = GPIO4, BtnB = GPIO3).
+#define PAPERDIY_BTN_A 4
+#define PAPERDIY_BTN_B 3
+
+// M5PM1 PMIC on the internal I2C bus (shared with the EPD power rail).
+#define PAPERDIY_PM1_SDA 41
+#define PAPERDIY_PM1_SCL 42
