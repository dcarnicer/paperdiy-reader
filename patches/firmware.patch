diff --git a/platformio.ini b/platformio.ini
index f96f6634..1bf112e1 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -622,6 +622,35 @@ build_flags =
   -DLOG_LEVEL=1 ; Set log level to info for release candidate builds
   -DUSE_BLOCK_DEVICE_INTERFACE=1
 
+; --- M5Stack PaperDIY — ESP32-S3 N16R8, ED047TC1 raw parallel, 2 buttons ------
+; Same panel/bus as PaperS3 but no touch/RTC/IMU, two GPIO buttons and an M5PM1
+; PMIC. Board support lives in freeink-sdk/libs/hardware/BoardPaperDiy.
+;   pio run -e paperdiy -t upload
+[env:paperdiy]
+extends = base
+board = esp32-s3-devkitc1-n16r8
+board_build.mcu = esp32s3
+board_build.flash_mode = qio
+board_build.arduino.memory_type = qio_opi
+build_flags =
+  ${base.build_flags}
+  -DFREEINK_DEVICE_PAPERDIY=1
+  -DBOARD_HAS_PSRAM
+  -DFREEINK_CAP_USB_MSC=1
+  -DFREEINK_CAP_BLE_HID_HOST=1
+  -DUSB_PRODUCT=\"CrossPoint_PaperDIY\"
+  -DUSB_MANUFACTURER=\"CrossPoint\"
+  -DCROSSPOINT_VERSION=\"${crosspoint.version}-paperdiy\"
+  -DENABLE_SERIAL_LOG
+  -DLOG_LEVEL=2
+  ; Fork OTA: uncomment and point at THIS fork before publishing releases.
+  ; The default (official CrossPoint) is safe because no -paperdiy asset exists.
+  ; -DCROSSPOINT_OTA_RELEASES_URL=\"https://api.github.com/repos/YOURUSER/paperdiy-reader/releases/latest\"
+lib_deps =
+  ${base.lib_deps}
+  BoardPaperDiy=symlink://freeink-sdk/libs/hardware/BoardPaperDiy
+  m5stack/M5GFX @ 0.2.33
+
 ; --- EEGO Reader A4 — ESP32-S3 N16R8, UC8279C 768x552 + GSLX680 touch ---------
 ; UC8279C SPI panel, GSLX680 touch, PCF8563 RTC, dedicated HSPI MicroSD (SPI,
 ; not SDMMC). 16MB DIO flash + 8MB OPI PSRAM. One binary serves the frontlit
