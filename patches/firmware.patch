+constexpr size_t MAX_LAUNCHER_HUB_RESPONSE = 64 * 1024;
+// Each page is a separate TLS fetch with a 60 s socket timeout; the paper-diy
+// category fits in one page of 100.
+constexpr int MAX_LAUNCHER_HUB_PAGES = 3;
