diff --git a/src/network/FirmwareVersion.cpp b/src/network/FirmwareVersion.cpp
new file mode 100644
index 00000000..66635873
--- /dev/null
+++ b/src/network/FirmwareVersion.cpp
@@ -0,0 +1,56 @@
+#include "FirmwareVersion.h"
+
+#include <cstdlib>
+#include <cstring>
+
+namespace firmware_version {
+namespace {
+
+// Reads a non-negative decimal at `p`; returns 0 when there is none.
+int readNumber(const char* p) {
+  if (p == nullptr || *p < '0' || *p > '9') return 0;
+  return static_cast<int>(std::strtol(p, nullptr, 10));
+}
+
+}  // namespace
+
+Version parse(const char* text) {
+  Version v;
+  if (text == nullptr) return v;
+  const char* p = text;
+  if (*p == 'v' || *p == 'V') ++p;
+
+  for (int i = 0; i < 3; ++i) {
+    if (*p < '0' || *p > '9') break;
+    char* end = nullptr;
+    v.base[i] = static_cast<int>(std::strtol(p, &end, 10));
+    p = end;
+    if (*p != '.') break;
+    ++p;
+  }
+
+  // The port revision is the number right after the CrossPoint version.
+  if (p[0] == '-' && p[1] >= '0' && p[1] <= '9') {
+    char* end = nullptr;
+    v.revision = static_cast<int>(std::strtol(p + 1, &end, 10));
+    p = end;
+  }
+
+  const char* rc = std::strstr(p, "-rc");
+  if (rc != nullptr) {
+    v.preRelease = rc[3] == '.' ? readNumber(rc + 4) : 0;
+  } else if (std::strstr(p, "-dev") != nullptr) {
+    v.preRelease = 0;
+  }
+  return v;
+}
+
+bool isNewer(const Version& a, const Version& b) {
+  for (int i = 0; i < 3; ++i) {
+    if (a.base[i] != b.base[i]) return a.base[i] > b.base[i];
+  }
+  if (a.revision != b.revision) return a.revision > b.revision;
+  return a.preRelease > b.preRelease;
+}
+
+}  // namespace firmware_version
diff --git a/src/network/FirmwareVersion.h b/src/network/FirmwareVersion.h
new file mode 100644
index 00000000..81fd80bf
--- /dev/null
+++ b/src/network/FirmwareVersion.h
@@ -0,0 +1,26 @@
+#pragma once
+
+// PaperDIY release versions: <CrossPoint X.Y.Z>-<N>[-rc.<M>], e.g. 2.0.0-1, with
+// an optional leading "v" on tags (see .agents/rules/release-versioning.md).
+// Ordering: CrossPoint version, then the port revision N, then a release
+// candidate before its final release. A missing segment or revision is 0, and
+// any "-rc"/"-dev" suffix counts as a pre-release of that version.
+namespace firmware_version {
+
+struct Version {
+  int base[3] = {0, 0, 0};
+  int revision = 0;
+  // Pre-release order: rc.M sorts as M; a final release sorts above any rc.
+  int preRelease = FINAL;
+
+  static constexpr int FINAL = 0x7fffffff;
+};
+
+Version parse(const char* text);
+
+// True when `a` is a later release than `b`.
+bool isNewer(const Version& a, const Version& b);
+
+inline bool isNewer(const char* a, const char* b) { return isNewer(parse(a), parse(b)); }
+
+}  // namespace firmware_version
