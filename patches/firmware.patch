diff --git a/src/platform/LauncherEnv.cpp b/src/platform/LauncherEnv.cpp
new file mode 100644
index 00000000..9712b033
--- /dev/null
+++ b/src/platform/LauncherEnv.cpp
@@ -0,0 +1,119 @@
+#include "LauncherEnv.h"
+
+#include <Arduino.h>
+#include <BoardConfig.h>
+#include <Logging.h>
+#include <esp_partition.h>
+#include <esp_sleep.h>
+#include <nvs.h>
+
+#if FREEINK_DEVICE_PAPERDIY || FREEINK_DEVICE_PAPERMONO
+#include <M5Pm1.h>
+#endif
+
+namespace launcher_env {
+namespace {
+
+constexpr const char* TAG = "LAUNCHER";
+
+const esp_partition_t* residentPartition() {
+  return esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_TEST, nullptr);
+}
+
+BootConfig readBootConfig() {
+  // Same namespace, keys and types as Launcher's settings.cpp (bool = u8,
+  // int = i32) and its keyboot bootloader. A missing key keeps the default.
+  BootConfig cfg;
+  nvs_handle_t handle;
+  if (nvs_open("launcher", NVS_READONLY, &handle) != ESP_OK) return cfg;
+  uint8_t u8 = 0;
+  if (nvs_get_u8(handle, "DDLB", &u8) == ESP_OK) cfg.ddlb = u8 != 0;
+  int32_t i32 = -1;
+  if (nvs_get_i32(handle, "LauncherOnKey", &i32) == ESP_OK) cfg.keyGpio = i32;
+  if (nvs_get_u8(handle, "LauncherKeyLvl", &u8) == ESP_OK) cfg.keyLevel = u8 != 0;
+  nvs_close(handle);
+  return cfg;
+}
+
+[[noreturn]] void deepSleepRestart() {
+  // RESET_REASON_CORE_DEEP_SLEEP: the bootloader starts Launcher unless DDLB.
+  LOG_INF(TAG, "Restarting into M5Launcher via deep-sleep wake");
+  logSerial.flush();
+  esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);
+  esp_sleep_enable_timer_wakeup(1000);
+  esp_deep_sleep_start();
+  // esp_deep_sleep_start() does not return; satisfy [[noreturn]] regardless.
+  ESP.restart();
+  while (true) {
+  }
+}
+
+bool pmicPowerOnReset() {
+#if FREEINK_DEVICE_PAPERDIY || FREEINK_DEVICE_PAPERMONO
+  if (!BoardConfig::isPaperDiy() && !BoardConfig::isPaperMono()) return false;
+  // SYS_CMD: KEY 0xA in the high nibble, 2 = reset. The PM1 resets the ESP32
+  // through CHIP_EN, which the bootloader sees as RESET_REASON_CHIP_POWER_ON.
+  constexpr uint8_t SYS_CMD_RESET = 0xA2;
+  LOG_INF(TAG, "Restarting into M5Launcher via M5PM1 reset");
+  logSerial.flush();
+  freeink::m5pm1::beginBus();
+  // Same settle time the PMIC reference driver uses before a system command.
+  delay(120);
+  if (!freeink::m5pm1::writeReg(freeink::m5pm1::REG_SYS_CMD, SYS_CMD_RESET)) {
+    LOG_ERR(TAG, "M5PM1 reset command was not acknowledged");
+    return false;
+  }
+  delay(2000);
+  LOG_ERR(TAG, "M5PM1 reset did not restart the device");
+#endif
+  return false;
+}
+
+}  // namespace
+
+bool isUnderLauncher() {
+  // The partition table is fixed for the lifetime of this boot; Launcher only
+  // rewrites it from its own firmware and then reboots.
+  static const bool detected = residentPartition() != nullptr;
+  return detected;
+}
+
+const BootConfig& bootConfig() {
+  // Launcher cannot change these while this app runs.
+  static const BootConfig cfg = readBootConfig();
+  return cfg;
+}
+
+void logStatus() {
+  if (!isUnderLauncher()) return;
+  const BootConfig& cfg = bootConfig();
+  LOG_INF(TAG, "M5Launcher detected: DDLB=%d LauncherOnKey=%d LauncherKeyLvl=%d", cfg.ddlb ? 1 : 0,
+          static_cast<int>(cfg.keyGpio), cfg.keyLevel ? 1 : 0);
+}
+
+bool exitToLauncher() {
+  if (!isUnderLauncher()) {
+    LOG_INF(TAG, "Not running under M5Launcher; refusing to leave the app");
+    return false;
+  }
+  const BootConfig& cfg = bootConfig();
+  if (cfg.hasKey()) {
+    LOG_INF(TAG, "LauncherOnKey=%d: Launcher starts only with that key held", static_cast<int>(cfg.keyGpio));
+    return false;
+  }
+  // A plain ESP.restart() (RTC_SW_CPU_RST) never starts Launcher. The
+  // deep-sleep wake was validated on hardware and needs no PMIC; use the
+  // PMIC power-on reset only when DDLB makes a deep-sleep wake skip Launcher.
+  if (!cfg.ddlb) deepSleepRestart();
+  return pmicPowerOnReset();
+}
+
+void restartWithKeyHeld() {
+  LOG_INF(TAG, "Restarting with LauncherOnKey held");
+  logSerial.flush();
+  ESP.restart();
+  while (true) {
+  }
+}
+
+}  // namespace launcher_env
diff --git a/src/platform/LauncherEnv.h b/src/platform/LauncherEnv.h
new file mode 100644
index 00000000..81040cff
--- /dev/null
+++ b/src/platform/LauncherEnv.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdint>
+
+// bmorcelli/Launcher ("M5Launcher") keeps its resident firmware in an
+// ESP_PARTITION_SUBTYPE_APP_TEST slot and boots installed apps from a dynamic
+// OTA partition. That marker lets an app detect the launcher and avoid
+// touching the boot selection or another installed app's OTA slot.
+namespace launcher_env {
+
+// Launcher's boot settings, read from its "launcher" NVS namespace. Launcher's
+// bootloader reads the same keys to choose between its own UI and the app:
+//   - keyGpio > 0: only that GPIO held at keyLevel starts Launcher, on any
+//     reset (power-on, deep-sleep wake, software restart).
+//   - otherwise:   power-on always starts Launcher; a deep-sleep wake does too
+//     unless ddlb is set; a software restart never does.
+struct BootConfig {
+  bool ddlb = false;      // CFG > DeepSleep starts Launcher, inverted
+  int32_t keyGpio = -1;   // CFG > GPIO on boot starts Launcher; -1 = off
+  bool keyLevel = false;  // level that counts as "held"
+  // The bootloader skips GPIO 0 (a boot strap) as well as -1.
+  bool hasKey() const { return keyGpio > 0; }
+};
+
+// True when the partition table contains Launcher's resident APP_TEST slot.
+bool isUnderLauncher();
+
+// Launcher's boot settings, read once per boot. Defaults (no key, DDLB off)
+// when the namespace or a key is missing, matching the bootloader.
+const BootConfig& bootConfig();
+
+// One log line with the detected Launcher boot settings; no-op otherwise.
+void logStatus();
+
+// Restart into Launcher's resident firmware when no key is configured: a
+// deep-sleep wake while DDLB is off, otherwise a power-on reset through the
+// M5PM1 (PaperDIY, Paper Mono). Returns false without restarting when a key is
+// configured (the caller must restart with the key held), when not under
+// Launcher, or when no restart path is available.
+bool exitToLauncher();
+
+// Software restart for the key mode. The bootloader starts Launcher only if
+// the configured key is held while it samples the pin.
+[[noreturn]] void restartWithKeyHeld();
+
+}  // namespace launcher_env
