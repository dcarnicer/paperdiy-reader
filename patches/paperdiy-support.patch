+    JsonDocument list;
+    if (!fetchLauncherHubJson(url, body, list, listFilter)) return HTTP_ERROR;
+    for (JsonObjectConst item : list["items"].as<JsonArrayConst>()) {
+      const char* name = item["name"] | "";
+      if (strcasecmp(name, launcherHubAppName) == 0) {
