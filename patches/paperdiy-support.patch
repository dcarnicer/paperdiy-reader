+  latestVersion = best;
+  otaUrl.clear();
+  otaSize = 0;
+  totalSize = 0;
+  updateAvailable = true;
+  LOG_DBG("OTA", "LauncherHub latest: %s (fid %s)", latestVersion.c_str(), fid.c_str());
+  return OK;
+}
