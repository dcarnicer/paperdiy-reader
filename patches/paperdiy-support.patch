diff --git a/freeink-sdk/libs/hardware/BoardPaperDiy/src/BoardPaperDiy.cpp b/freeink-sdk/libs/hardware/BoardPaperDiy/src/BoardPaperDiy.cpp
new file mode 100644
index 00000000..7134b038
--- /dev/null
+++ b/freeink-sdk/libs/hardware/BoardPaperDiy/src/BoardPaperDiy.cpp
@@ -0,0 +1,84 @@
+#include <BoardPaperDiy.h>
+#include <M5Pm1.h>
+
+namespace {
+
+// PM1 GPIO2 is the PaperDIY EPD rail enable, in addition to the panel's own
+// GPIO46 pin. M5GFX's autodetect does the same four GPIO register writes; the
+// PM1's PWR_CFG auto-clears on reset, so the charge/DCDC policy must be
+// re-applied on every boot.
+bool ensurePm1Ready() {
+  using namespace freeink::m5pm1;
+
+  beginBus();
+  // PaperDIY needs the charger and the 5 V DCDC (panel boost) on. Unlike
+  // PaperColor it has no Grove/5VINOUT boost and no RGB rail, so keep BOOST_EN,
+  // LDO_EN and LED_R_EN off. PWR_CFG auto-clears on reset: re-apply each boot.
+  updateReg(REG_PWR_CFG, BOOST_EN | LDO_EN | LED_R_EN, CHG_EN | DCDC_EN);
+  writeReg(REG_NEO_CFG, 0x00);
+  // The LGS4056H has a 4.2 V target, but the PM1 protects the cell from deep
+  // discharge. 3.4 V leaves the tail of the Li-ion curve and e-ink sag margin.
+  // Best-effort: a rejected LVP write must not stop the EPD rail from coming up.
+  setBatteryLowVoltageProtection(3400);
+
+  bool ok = updateReg(REG_GPIO_FUNC0, 0x03 << 4, 0);  // GPIO2 = plain GPIO
+  ok = updateReg(REG_GPIO_MODE, 0, GPIO2) && ok;       // output
+  ok = updateReg(REG_GPIO_DRV, GPIO2, 0) && ok;        // push-pull
+  ok = updateReg(REG_GPIO_OUT, 0, GPIO2) && ok;        // high
+
+  // PM1 GPIO3 is CHG_STAT (active-low, needs a pull-up); BatteryMonitor reads it.
+  ok = updateReg(REG_GPIO_FUNC0, 0x03 << 6, 0) && ok;          // GPIO3 = plain GPIO
+  ok = updateReg(REG_GPIO_MODE, GPIO3, 0) && ok;               // input
+  ok = updateReg(REG_GPIO_PULL0, 0x03 << 6, 0x01 << 6) && ok;  // pull-up
+
+#if PAPERDIY_PM1_APP_POWER_BUTTON
+  // Take over the PM1 single-click reset so clicks reach CrossPoint. The PM1's
+  // long-hold download escape is left enabled by configureAppPowerButton().
+  ok = configureAppPowerButton() && ok;
+#endif
+
+  if (ok) delay(10);
+  return ok;
+}
+
+}  // namespace
+
+namespace BoardPaperDiy {
+
+bool ensureBooted() {
+  static bool ready = false;
+  static bool ok = false;
+  if (ready) return ok;
+  ok = ensurePm1Ready();
+  ready = ok;
+  return ok;
+}
+
+bool setEpdPower(bool enabled) {
+  if (!ensureBooted()) return false;
+  using namespace freeink::m5pm1;
+  const bool ok = updateReg(REG_GPIO_OUT, GPIO2, enabled ? GPIO2 : 0);
+  if (ok && enabled) delay(10);
+  return ok;
+}
+
+bool prepareEpdPower() { return setEpdPower(true); }
+
+void powerDownEpdPower() { setEpdPower(false); }
+
+bool pollPowerButtonClicked(unsigned long nowMs) {
+  static unsigned long lastPollMs = 0;
+  constexpr unsigned long POLL_INTERVAL_MS = 250;
+  if (nowMs - lastPollMs < POLL_INTERVAL_MS) return false;
+  lastPollMs = nowMs;
+  if (!ensureBooted()) return false;
+  uint8_t status = 0;
+  return freeink::m5pm1::readButtonStatus(&status) && (status & freeink::m5pm1::BTN_EVENT) != 0;
+}
+
+void powerOff() {
+  freeink::m5pm1::beginBus();
+  freeink::m5pm1::requestShutdown();
+}
+
+}  // namespace BoardPaperDiy
diff --git a/freeink-sdk/libs/hardware/BoardPaperDiy/src/PaperDiyLgfxConfig.cpp b/freeink-sdk/libs/hardware/BoardPaperDiy/src/PaperDiyLgfxConfig.cpp
new file mode 100644
index 00000000..de106962
--- /dev/null
+++ b/freeink-sdk/libs/hardware/BoardPaperDiy/src/PaperDiyLgfxConfig.cpp
@@ -0,0 +1,74 @@
+#include <BoardPaperDiy.h>
+#include <LgfxEpdConfig.h>
+
+namespace {
+
+#define LUT_MAKE(d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, da, db, dc, dd, de, df)                                \
+  (uint32_t)((d0 << 0) | (d1 << 2) | (d2 << 4) | (d3 << 6) | (d4 << 8) | (d5 << 10) | (d6 << 12) | (d7 << 14) | \
+             (d8 << 16) | (d9 << 18) | (da << 20) | (db << 22) | (dc << 24) | (dd << 26) | (de << 28) | (df << 30))
+
+// Single waveform for BOTH the B/W base push and the AA gray overlay push.
+// Panel_EPD's per-pixel diff embeds the epd_mode LUT offset in the stored
+// value, so alternating modes between the two pushes of a page turn defeats
+// the diff and re-drives the whole screen -- the LovyanGFX default lut_fast
+// then flashes every white pixel black for two frames (the full-screen black
+// "swipe"). Using one LUT under one mode keeps unchanged pixels skipped.
+// Columns 0/15 carry the default lut_fast drive (changed B/W text pixels);
+// columns 1-6 / 9-14 carry the AA nudge for the gray levels AA produces.
+//
+// The paperdiy panel is the same ED047TC1 used by the LilyGo T5 S3, so this
+// reuses the waveform validated there. It is a trial: the PMIC/VCOM path is
+// different on PaperDIY, so verify contrast and ghosting on hardware.
+constexpr uint32_t kFastLut[] = {
+    LUT_MAKE(2, 1, 1, 1, 1, 1, 1, 3, 3, 2, 2, 2, 2, 2, 2, 1),
+    LUT_MAKE(2, 3, 1, 1, 1, 1, 3, 3, 3, 3, 2, 2, 2, 2, 3, 1),
+    LUT_MAKE(1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2),
+    LUT_MAKE(1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2),
+    LUT_MAKE(1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2),
+    LUT_MAKE(1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2),
+    LUT_MAKE(1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2),
+    LUT_MAKE(1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2),
+    ~0u,
+    0u,
+};
+
+#undef LUT_MAKE
+
+}  // namespace
+
+namespace freeink {
+
+// The PaperDIY panel bus is pin-for-pin the PaperS3 bus (M5GFX uses the same
+// Bus_EPD config for board_M5PaperDIY and board_M5PaperS3). The only extra
+// hardware is the M5PM1 EPD rail, raised in prepare() before Bus_EPD init.
+const LgfxEpdConfig& paperdiyLgfxConfig() {
+  static const LgfxEpdConfig cfg = {
+      {PAPERDIY_EP_D0, PAPERDIY_EP_D1, PAPERDIY_EP_D2, PAPERDIY_EP_D3, PAPERDIY_EP_D4, PAPERDIY_EP_D5, PAPERDIY_EP_D6,
+       PAPERDIY_EP_D7},
+      PAPERDIY_EP_SPH,
+      PAPERDIY_EP_SPV,
+      PAPERDIY_EP_OE,
+      PAPERDIY_EP_LE,
+      PAPERDIY_EP_CL,
+      PAPERDIY_EP_CKV,
+      PAPERDIY_EP_PWR,
+      16000000,                                             // busHz — M5GFX's bus_speed for this board
+      8,                                                    // linePadding — M5GFX's line_padding for this board
+      0,                                                    // rotation: native-landscape 960x540 framebuffer
+      {&BoardPaperDiy::prepareEpdPower, nullptr, nullptr},  // stock Bus_EPD power sequence
+      // Stock quality/text banks; fast and fastest share the ED047TC1 AA
+      // waveform above so the base and gray pushes of a page turn stay on the
+      // same LUT offset.
+      nullptr,
+      0,
+      nullptr,
+      0,
+      kFastLut,
+      sizeof(kFastLut) / sizeof(kFastLut[0]),
+      kFastLut,
+      sizeof(kFastLut) / sizeof(kFastLut[0]),
+  };
+  return cfg;
+}
+
+}  // namespace freeink
